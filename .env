# ══════════════════════════════════════════════════════════════
# AlphaForge Anton — Root Environment Configuration
# ══════════════════════════════════════════════════════════════
# Tracked file with non-secret defaults.
# Credentials live in .env.cred.local (gitignored).
# Service ports live in .env.port.
# ══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=AlphaForge Anton
APP_ENV=development                       # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=alphaforge-anton.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Broker refetch (CSV cache TTL, seconds) ──────────────────
# After this window the next sync re-fetches from the broker via CDP.
ZERODHA_REFETCH_SECONDS=3600
GROWW_REFETCH_SECONDS=3600
ANGELONE_REFETCH_SECONDS=3600
INDMONEY_REFETCH_SECONDS=3600
TICKERTAPE_REFETCH_SECONDS=3600
ZERODHA_COIN_REFETCH_SECONDS=3600

# ── Database ─────────────────────────────────────────────────
# POSTGRES_USER, POSTGRES_PASSWORD are in .env.cred.local (auto-generated by setup-config.sh)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT:-5432}/alphaforge_anton

# ── Auth / JWT ───────────────────────────────────────────────
# JWT_SECRET_KEY is in .env.cred.local
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:${FRONTEND_PORT:-3000}"]

# ── LLM Gateway ──────────────────────────────────────────────
# API keys (GEMINI_API_KEY, GROQ_API_KEY, HF_API_KEY, OPENROUTER_API_KEY,
# CEREBRAS_API_KEY, MISTRAL_API_KEY) are vault-managed via afbach.
# See .env.cred.example for the full list.
OLLAMA_BASE_URL=http://localhost:11434

# Optional: override default holdings CSV dump directory (default: <repo-root>/portfolio-dumps).
# PORTFOLIO_DUMP_DIR=~/.alphaforge-anton/portfolio-dumps
