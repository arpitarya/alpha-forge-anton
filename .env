# ══════════════════════════════════════════════════════════════
# AlphaForge Anton — Root Environment Configuration
# ══════════════════════════════════════════════════════════════
# Tracked file with non-secret defaults.
# Credentials live in .env.cred.local (gitignored).
# Service ports live in .env.port.
# ══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=AlphaForge Anton
APP_ENV=development                       # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=alphaforge-anton.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Broker sync retries (boot-time sync-stream) ──────────────
# Max attempts per broker before giving up. Delay between retries (seconds).
BROKER_SYNC_RETRY_COUNT=3
BROKER_SYNC_RETRY_DELAY_SECONDS=8

# ── Broker refetch (CSV cache TTL, seconds) ──────────────────
# After this window the next sync re-fetches from the broker via CDP.
ZERODHA_REFETCH_SECONDS=3600
GROWW_REFETCH_SECONDS=3600
ANGELONE_REFETCH_SECONDS=3600
INDMONEY_REFETCH_SECONDS=3600
TICKERTAPE_REFETCH_SECONDS=3600
ZERODHA_COIN_REFETCH_SECONDS=3600

# ── Database ─────────────────────────────────────────────────
# POSTGRES_USER, POSTGRES_PASSWORD are in .env.cred.local (auto-generated by setup-config.sh)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT:-5432}/alphaforge_anton

# ── Auth / JWT ───────────────────────────────────────────────
# JWT_SECRET_KEY is in .env.cred.local
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:${FRONTEND_PORT:-3000}"]

# ── Public (exposed to browser) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AlphaForge Anton
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Boot gate: when "true", a blocking boot splash polls /health/boot every 2s
# and won't release the terminal/portfolio until vault is unlocked + every
# critical probe (backend, database, vault, LLM) is OK. Set "false" to skip
# the splash (useful for screenshots / dev).
NEXT_PUBLIC_BOOT_GATE_ENABLED=true

# ── Server-only (SSR / API routes) ──────────────────────────
# Internal backend URL (used by Next.js server-side requests, e.g. inside Docker)
INTERNAL_API_URL=http://localhost:8000

# ── Port ─────────────────────────────────────────────────────
# Must match FRONTEND_PORT in .env.port at repo root
FRONTEND_PORT=3000

# ── Logging (server-only) ───────────────────────────────────
LOG_LEVEL=info                            # trace | debug | info | warn | error | fatal
LOG_DIR=logs                              # Directory for log files (relative to frontend/)
LOG_FILE=alphaforge-anton-frontend.log          # Log filename


# ── Filesystem paths ─────────────────────────────────────────
# Constitution `configurable-paths`: every dir/file the app reads or writes is
# env-configurable here — no module hardcodes a home or absolute path. All paths
# derive from ANTON_DATA_DIR (resolved in backend/app/core/paths.py) and stay
# individually overridable. Override base OR any single path; ~ is expanded; a
# relative override resolves under ANTON_DATA_DIR. Real per-machine paths → .env.local.

# Per-machine data root — the single base every default below derives from.
# ANTON_DATA_DIR=~/.alphaforge-anton

# Portfolio CSV dump dir — per-broker holdings dumps (chmod 700).
# Special case: a RELATIVE value resolves from the repo root, not ANTON_DATA_DIR.
# PORTFOLIO_DUMP_DIR=~/.alphaforge-anton/portfolio-dumps

# NSE market-data dir — the raw bhavcopy .zip + index .csv cache + cache-manifest.json.
# Defaults to $ANTON_DATA_DIR/nse (via app.core.paths.resolve); set a value to relocate it.
# NSE_DATA_DIR=~/.alphaforge-anton/nse

# NSE ingestion politeness dials (NOT paths). Resume is manifest-based, so re-running
# `just ingest-nse` never re-downloads a day already recorded in cache-manifest.json.
# For a large historical backfill, run polite-serial so NSE never throttles:
#   NSE_WORKERS=2 NSE_REQUEST_DELAY=1.0 just ingest-nse 2016-01-01 <today>
# NSE_WORKERS=8            # parallel fetch workers (default 8; lower to 1-2 to avoid throttling)
# NSE_REQUEST_DELAY=0      # seconds to pause before each NSE GET (+jitter); default 0 (off)

# Signals cache dir — daily yfinance quotes + the once-a-day Nifty-500 list.
# SIGNALS_CACHE_DIR=~/.alphaforge-anton/signals-cache

# Edge-discovery trial-budget ledger (append-only JSONL, counts only).
# EDGES_TRIAL_LEDGER=~/.alphaforge-anton/edges-trials.jsonl

# Dante security policy files (gateway egress policy + step-up posture rules).
# DANTE_GATEWAY_POLICY=~/.alphaforge-anton/dante/dante.yaml
# DANTE_POSTURE_YAML=~/.alphaforge-anton/dante/posture.yaml

# Broker HTTP response cache (relative → from repo root). Optional encrypt key.
# BROKER_CACHE_DIR=.cache/brokers
# BROKER_CACHE_KEY=

# Private elgar money-doc store — CONSTITUTIONAL: never this repo. The elgar sibling
# tool OWNS its store + path; Anton owns NO elgar path and reaches it only via the
# elgar CLI (app.modules.plans.elgar_bridge). So there is no ELGAR_DIR here — relocate
# the store by configuring elgar itself. Anton only needs to find the executable:
# ELGAR_BIN=elgar    # path/name of the elgar CLI (default: `elgar` on PATH)

# Claude transcript dir — concierge call-cost import (outside ANTON_DATA_DIR by design).
# CLAUDE_PROJECTS=~/.claude/projects
