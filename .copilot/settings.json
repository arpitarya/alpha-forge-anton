{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"Fux: Use `fux why <id>` to look up rules, `fux refs <path>` to see file governance. graphify: Read graphify-out/GRAPH_REPORT.md if it exists.\"}}'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/arpitarya/.claude/fux/hooks/session_start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/arpitarya/.claude/fux/hooks/post_tool_use.sh"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/arpitarya/.claude/fux/hooks/stop.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/arpitarya/.claude/fux/hooks/user_prompt_submit.sh"
          }
        ]
      }
    ]
  }
}
