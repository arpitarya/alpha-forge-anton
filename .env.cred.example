# ══════════════════════════════════════════════════════════════
# AlphaForge Anton — Credentials TEMPLATE (tracked in git, blank values)
# Copy to .env.cred.local and fill in your values.
# Broker-specific secrets (user IDs, API keys) live in the afbach vault.
# ══════════════════════════════════════════════════════════════

# ── afbach vault (bootstrap — must be in file to reach vault at startup) ──
AFBACH_URL=
AFBACH_TOKEN=

# ── Fallbacks (used when vault is locked; vault values take priority) ─────
# Fernet key for encrypting cached broker session tokens at rest.
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BROKER_CACHE_KEY=

# Auto-generated by setup-config.sh (secrets.token_urlsafe)
JWT_SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=alphaforge_anton
# Auto-generated by setup-config.sh (secrets.token_urlsafe)
POSTGRES_PASSWORD=

# ── Wagner IAM ────────────────────────────────────────────────────────────
# bcrypt hash of admin password.
# Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'pw', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
