# ══════════════════════════════════════════════════════════════
# AlphaForge Anton — Credentials TEMPLATE (this file IS tracked in git)
# ══════════════════════════════════════════════════════════════
# Real values go in .env.cred.local (gitignored). Copy this file:
#
#   cp .env.cred.example .env.cred.local   # then fill in real values
#
# .env.cred.local is loaded after .env.cred.example by env_loader and
# overrides any value here.
#
# DO NOT add real secrets to this file — it is committed.
# ══════════════════════════════════════════════════════════════

# ── App Secrets ──────────────────────────────────────────────
JWT_SECRET_KEY=
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(12)).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Plaintext password — required ONLY for the broker dev notebooks
# (backend/notebooks/*_dev.ipynb) which need to POST it to /api/v1/auth/token
# to obtain a JWT. Keep this matching whatever you hashed into
# ADMIN_PASSWORD_HASH above. Never read by production code paths.
ADMIN_PASSWORD=

# ── Database Credentials ─────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Indian Broker: Zerodha Kite (manual CDP login) ───────────
# AlphaForge Anton does NOT store your password or TOTP. You log in once
# inside Chrome (started with --remote-debugging-port=9299) and the
# backend reads the session cookie via CDP. Only your client ID is needed.
ZERODHA_USER_ID=

# ── Indian Broker: Groww (CDP web-app fetch) ─────────────────
# Log in to groww.in inside the same AlphaForge Anton Chrome session.
# Only your registered email / user ID is needed here.
GROWW_USER_ID=

# ── Indian Broker: Angel One (CDP web-app fetch) ─────────────
# Log in to angelone.in inside the same AlphaForge Anton Chrome session
# (started with --remote-debugging-port=9299). Only your client ID is needed.
ANGELONE_CLIENT_ID=

# ── Indian Broker: INDmoney (CDP web-app fetch) ───────────────
# Log in to indmoney.com inside the same AlphaForge Anton Chrome session.
# US equity holdings. Only your registered mobile / user ID is needed.
INDMONEY_USER_ID=

# ── Indian Broker: Ticker Tape (CDP web-app fetch) ────────────
# Log in to tickertape.in inside the same AlphaForge Anton Chrome session.
# Digital gold: SGB, gold ETF, gold MF. Only your user ID is needed.
TICKERTAPE_USER_ID=

# Required: Fernet key for encrypting cached broker session tokens at rest.
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BROKER_CACHE_KEY=

