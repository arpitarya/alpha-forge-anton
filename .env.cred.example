# ══════════════════════════════════════════════════════════════
# AlphaForge Anton — Credentials TEMPLATE (this file IS tracked in git)
# ══════════════════════════════════════════════════════════════

# ── afbach vault ─────────────────────────────────────────────
AFBACH_URL=
AFBACH_TOKEN=

# Required: Fernet key for encrypting cached broker session tokens at rest.
# Auto-generated by setup-config.sh (cryptography.fernet)
BROKER_CACHE_KEY=

# ── Auth ──────────────────────────────────────────────────────
# Auto-generated by setup-config.sh (secrets.token_urlsafe)
JWT_SECRET_KEY=
# bcrypt hash of the admin password. Generate: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=alphaforge_anton
# Auto-generated by setup-config.sh (secrets.token_urlsafe)
POSTGRES_PASSWORD=

# ── LLM Gateway ──────────────────────────────────────────────
# Managed via afbach vault. Set here only if not using the vault.
# Get free keys: aistudio.google.com, console.groq.com, huggingface.co,
# openrouter.ai, cerebras.ai, mistral.ai
GEMINI_API_KEY=
GROQ_API_KEY=
HF_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

