# ══════════════════════════════════════════════════════════════
# AlphaForge — Credentials TEMPLATE (this file IS tracked in git)
# ══════════════════════════════════════════════════════════════
# Real values go in .env.cred.local (gitignored). Copy this file:
#
#   cp .env.cred.example .env.cred.local   # then fill in real values
#
# .env.cred.local is loaded after .env.cred.example by env_loader and
# overrides any value here.
#
# DO NOT add real secrets to this file — it is committed.
# ══════════════════════════════════════════════════════════════

# ── App Secrets ──────────────────────────────────────────────
JWT_SECRET_KEY=
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(12)).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ── Database Credentials ─────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Indian Broker: Zerodha Kite (manual CDP login) ───────────
# AlphaForge does NOT store your password or TOTP. You log in once
# inside Chrome (started with --remote-debugging-port=9299) and the
# backend reads the session cookie via CDP. Only your client ID is needed.
ZERODHA_USER_ID=

# ── Indian Broker: Groww (CDP web-app fetch) ─────────────────
# Log in to groww.in inside the same AlphaForge Chrome session.
# Only your registered email / user ID is needed here.
GROWW_USER_ID=

# ── Indian Broker: Wint Wealth (CDP web-app fetch) ───────────
# Log in to wintwealth.com inside the same AlphaForge Chrome session.
# Primarily bonds, NCDs, and Sovereign Gold Bonds (SGBs).
WINTWEALTH_USER_ID=

# ── Indian Broker: Angel One (SmartAPI + TOTP) ───────────────
# Register a FREE app at https://smartapi.angelbroking.com to obtain the
# API key. Enable TOTP on your Angel One account (Profile → 2FA) and copy
# the base32 secret shown beneath the QR code. AlphaForge derives the
# 6-digit code locally each login — the secret never leaves your machine.
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=


# Required: Fernet key for encrypting cached broker session tokens at rest.
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BROKER_CACHE_KEY=

